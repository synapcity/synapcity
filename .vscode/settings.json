{
  // "deno.enable": false,
  "prettier.enable": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "editor.formatOnSave": true,
  // "tailwindCSS.experimental.classRegex": [
  //   "clsx\\(([^)]*)\\)",
  //   "cva\\(([^)]*)\\)",
  //   "cn\\(([^)]*)\\)"
  // ],
  "editor.codeActionsOnSave": {
    "eslint.useFlatConfig": "always",
    "eslint.format.enable": "always",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never" // let eslint-plugin-import handle ordering if you prefer
  },
  "editor.linkedEditing": true,
  "prettier.prettierPath": "node_modules/prettier",
  "prettier.configPath": "@build-setup/prettier",
  "prettier.ignorePath": "packages/build-setup/prettier/ignore"
}
